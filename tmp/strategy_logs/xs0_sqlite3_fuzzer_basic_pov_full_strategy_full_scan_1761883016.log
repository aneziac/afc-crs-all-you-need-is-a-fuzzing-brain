     switch( eType ){\n              case SQLITE_NULL: {\n                printf("NULL\\n");\n                break;\n              }\n              case SQLITE_INTEGER: {\n                printf("INT %s\\n", sqlite3_column_text(pStmt,i));\n                break;\n              }\n              case SQLITE_FLOAT: {\n                printf("FLOAT %s\\n", sqlite3_column_text(pStmt,i));\n                break;\n              }\n              case SQLITE_TEXT: {\n                printf("TEXT [%s]\\n", sqlite3_column_text(pStmt,i));\n                break;\n              }\n              case SQLITE_BLOB: {\n                printf("BLOB (%d bytes)\\n", sqlite3_column_bytes(pStmt,i));\n                break;\n              }\n            }\n          }\n        }\n      }         \n      sqlite3_finalize(pStmt);\n    }\n  }\n}'}, {'Name': 'incrAggFunctionDepth', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 107085, 'EndLine': 107085, 'SourceCode': 'static void incrAggFunctionDepth(Expr *pExpr, int N){'}, {'Name': 'codeTableLocks', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 122014, 'EndLine': 122014, 'SourceCode': 'static void codeTableLocks(Parse *pParse){'}, {'Name': 'resolveOrderByTermToExprList', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 108566, 'EndLine': 108566, 'SourceCode': 'static int resolveOrderByTermToExprList('}, {'Name': 'nfsUnlock', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 41714, 'EndLine': 41714, 'SourceCode': 'static int nfsUnlock(sqlite3_file *id, int eFileLock){'}, {'Name': 'rbuOpenDatabase', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 222225, 'EndLine': 222225, 'SourceCode': 'static void rbuOpenDatabase(sqlite3rbu *p, sqlite3 *dbMain, int *pbRetry){'}, {'Name': 'session