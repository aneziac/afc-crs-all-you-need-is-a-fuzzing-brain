 = 0;\n\n  va_start(ap, zFormat);\n  zSql = sqlite3_vmprintf(zFormat, ap);\n  va_end(ap);\n  check_oom(zSql);\n  rc = sqlite3_prepare_v2(p->db, zSql, -1, &pStmt, 0);\n  if( rc!=SQLITE_OK ){\n    fprintf(stderr, "SQL error (%d,%d): %s\\nWhile preparing: [%s]\\n",\n            rc, sqlite3_extended_errcode(p->db), sqlite3_errmsg(p->db), zSql);\n    exit(1);\n  }\n  worker_trace(p, "running [%s]", zSql);\n  while( (rc = sqlite3_step(pStmt))!=SQLITE_DONE ){\n    if( (rc&0xff)==SQLITE_BUSY || (rc&0xff)==SQLITE_LOCKED ){\n      sqlite3_reset(pStmt);\n      nRetry++;\n      if( nRetry<10 ){\n        worker_trace(p, "retry %d for [%s]", nRetry, zSql);\n        sched_yield();\n        continue;\n      }else{\n        fprintf(stderr, "Deadlock in thread %d while running [%s]\\n",\n                p->tid, zSql);\n        exit(1);\n      }\n    }\n    if( rc!=SQLITE_ROW ){\n      fprintf(stderr, "SQL error (%d,%d): %s\\nWhile running [%s]\\n",\n              rc, sqlite3_extended_errcode(p->db), sqlite3_errmsg(p->db), zSql);\n      exit(1);\n    }\n  }\n  sqlite3_free(zSql);\n  sqlite3_finalize(pStmt);\n}'}, {'Name': 'constraintCompatibleWithOuterJoin', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 163981, 'EndLine': 163981, 'SourceCode': 'static int constraintCompatibleWithOuterJoin('}, {'Name': 'sqlite3_close_v2', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 182418, 'EndLine': 182418, 'SourceCode': 'SQLITE_API int sqlite3_close_v2(sqlite3 *db){ return sqlite3Close(db,1); }'}, {'Name': 'sqlite3changegroup_add', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 232299, 'EndLine': 232299, 'SourceCode': 'SQLITE_API int sqlite3changegroup_add(sqlite3_changegroup *pGrp, int nData, void *pData){'}, {'Name': 'dupedExprStructSize', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLin