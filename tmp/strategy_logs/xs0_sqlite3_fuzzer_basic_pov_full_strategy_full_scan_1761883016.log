-test-sqlite3-full-01/afc-sqlite3/test/fuzzcheck.c', 'StartLine': 1448, 'EndLine': 1468, 'SourceCode': 'static int inmemRead(\n  sqlite3_file *pFile,   /* Read from this open file */\n  void *pData,           /* Store content in this buffer */\n  int iAmt,              /* Bytes of content */\n  sqlite3_int64 iOfst    /* Start reading here */\n){\n  VHandle *pHandle = (VHandle*)pFile;\n  VFile *pVFile = pHandle->pVFile;\n  if( iOfst<0 || iOfst>=pVFile->sz ){\n    memset(pData, 0, iAmt);\n    return SQLITE_IOERR_SHORT_READ;\n  }\n  if( iOfst+iAmt>pVFile->sz ){\n    memset(pData, 0, iAmt);\n    iAmt = (int)(pVFile->sz - iOfst);\n    memcpy(pData, pVFile->a + iOfst, iAmt);\n    return SQLITE_IOERR_SHORT_READ;\n  }\n  memcpy(pData, pVFile->a + iOfst, iAmt);\n  return SQLITE_OK;\n}'}, {'Name': 'icuCaseFunc16', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 218296, 'EndLine': 218296, 'SourceCode': 'static void icuCaseFunc16(sqlite3_context *p, int nArg, sqlite3_value **apArg){'}, {'Name': 'fts5StructurePromote', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 243736, 'EndLine': 243736, 'SourceCode': 'static void fts5StructurePromote('}, {'Name': 'rbuCheckpointFrame', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 222584, 'EndLine': 222584, 'SourceCode': 'static void rbuCheckpointFrame(sqlite3rbu *p, RbuFrame *pFrame){'}, {'Name': 'downgradeAllSharedCacheTableLocks', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 71146, 'EndLine': 71146, 'SourceCode': 'static void downgradeAllSharedCacheTableLocks(Btree *p){'}, {'Name': 'rbuTargetNameFunc', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 220396, 'EndLine': 220396, 'SourceCode': 'static void rbuTargetNameFunc('}, {'Name': 'sqlite3_keyword_count', 'FilePath': '/h