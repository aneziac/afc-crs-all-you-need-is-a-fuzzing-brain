: '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 150309, 'EndLine': 150309, 'SourceCode': 'static void assignAggregateRegisters(Parse *pParse, AggInfo *pAggInfo){'}, {'Name': 'sqlite3Fts5PoslistWriterAppend', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 237118, 'EndLine': 237118, 'SourceCode': 'static int sqlite3Fts5PoslistWriterAppend('}, {'Name': 'winLockSharedMemory', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 50607, 'EndLine': 50607, 'SourceCode': 'static int winLockSharedMemory(winShmNode *pShmNode){'}, {'Name': 'decodeDatabase', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/fuzzcheck.c', 'StartLine': 734, 'EndLine': 813, 'SourceCode': 'static int decodeDatabase(\n  const unsigned char *zIn,      /* Input text to be decoded */\n  int nIn,                       /* Bytes of input text */\n  unsigned char **paDecode,      /* OUT: decoded database file */\n  int *pnDecode                  /* OUT: Size of decoded database */\n){\n  unsigned char *a, *aNew;       /* Database under construction */\n  int mx = 0;                    /* Current size of the database */\n  sqlite3_uint64 nAlloc = 4096;  /* Space allocated in a[] */\n  unsigned int i;                /* Next byte of zIn[] to read */\n  unsigned int j;                /* Temporary integer */\n  unsigned int k;                /* half-byte cursor index for output */\n  unsigned int n;                /* Number of bytes of input */\n  unsigned char b = 0;\n  if( nIn<4 ) return -1;\n  n = (unsigned int)nIn;\n  a = sqlite3_malloc64( nAlloc );\n  if( a==0 ){\n    fprintf(stderr, "Out of memory!\\n");\n    exit(1);\n  }\n  memset(a, 0, (size_t)nAlloc);\n  for(i=k=0; i<n; i++){\n    unsigned char c = (unsigned char)zIn[i];\n    if( isxdigit(c) ){\n      k++;\n      if( k & 1 ){\n        b = hexToInt(c)*16;\n      }else{\n        b += hexToInt(c);\n        j = k/2 - 1;\n        if( j>=nAlloc ){\n          sqlite3_uint64 newSize;\n          if( nAlloc==MX_FILE_SZ || j>=MX_FILE_SZ ){\n            if( eVerbosity ){\n              fprintf(stderr, "Input database too big: max %d bytes\\n",\n                      MX_FILE_SZ);\n            }\n            sqlite3_free(a);\n            return -1;\n          }\n          newSize = nAlloc*2;\n          if( newSize<=j ){\n            newSize = (j+4096)&~4095;\n          }\n          if( newSize>MX_FILE_SZ ){\n            if( j>=MX_FILE_SZ ){\n              sqlite3_free(a);\n              return -1;\n            }\n            newSize = MX_FILE_SZ;\n          }\n          aNew = sqlite3_realloc64( a, newSize );\n          if( aNew==0 ){\n            sqlite3_free(a);\n            return -1;\n          }\n          a = aNew;\n          assert( newSize > nAlloc );\n          memset(a+nAlloc, 0, (size_t)(newSize - nAlloc));\n          nAlloc = newSize;\n        }\n        if( j>=(unsigned)mx ){\n          mx = (j + 4095)&~4095;\n          if( mx>MX_FILE_SZ ) mx = MX_FILE_SZ;\n        }\n        assert( j<nAlloc );\n        a[j] = b;\n      }\n    }else if( zIn[i]==\'[\' && i<n-3 && isOffset(zIn+i, nIn-i, &k, &i) ){\n      continue;\n   }else if( zIn[i]==\'\\n\' && i<n-4 && memcmp(zIn+i,"\\n--\\n",4)==0 ){\n      i += 4;\n      break;\n    }\n  }\n  *pnDecode = mx;\n  *paDecode = a;\n  return i;\n}'}, {'Name': 'sql_script_x', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/threadtest3.c', 'StartLine': 593, 'EndLine': 601, 'SourceCode': 'static void sql_script_x(\n  Error *pErr,                    /* IN/OUT: Error code */\n  Sqlite *pDb,                    /* Database handle */\n  const char *zSql                /* SQL script to execute */\n){\n  if( pErr->rc==SQLITE_OK ){\n    pErr->rc = sqlite3_exec(pDb->db, zSql, 0, 0, &pErr->zErr);\n  }\n}'}, {'Name': 'fts5StructureDecode', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 243313, 'EndLine': 243313, 'SourceCode': 'static int fts5StructureDecode('}, {'Name': 'pthreadMutexFree', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 29753, 'EndLine': 29753, 'SourceCode': 'static void pthreadMutexFree(sqlite3_mutex *p){'}, {'Name': 'sqlite3Fts5ParserFallback', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 238435, 'EndLine': 238435, 'SourceCode': 'static int sqlite3Fts5ParserFallback(int);'}, {'Name': 'fts5ApiInstToken', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 254049, 'EndLine': 254049, 'SourceCode': 'static int fts5ApiInstToken('}, {'Name': 'kvvfsAccess', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 38334, 'EndLine': 38334, 'SourceCode': 'static int kvvfsAccess('}, {'Name': 'fts3EvalRestart', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 193205, 'EndLine': 193205, 'SourceCode': 'static void fts3EvalRestart('}, {'Name': 'sqlite3_value_double', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 90706, 'EndLine': 90706, 'SourceCode': 'SQLITE_API double sqlite3_value_double(sqlite3_value *pVal){'}, {'Name': 'memdbRandomness', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 53631, 'EndLine': 53631, 'SourceCode': 'static int memdbRandomness(sqlite3_vfs *pVfs, int nByte, char *zBufOut){'}, {'Name': 'afpClose', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 41666, 'EndLine': 41666, 'SourceCode': 'static int afpClose(sqlite3_file *id) {'}, {'Name': 'sqlite3Fts5ExprPattern', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 238