e3_finalize(pStmt);\n  sqlite3_close(db);\n  if( sqlite3_memory_used()>0 ){\n    fprintf(stderr, "memory leak of %lld bytes\\n",\n         sqlite3_memory_used());\n    exit(1);\n  }\n  return 0;\n}'}, {'Name': 'sqlite3_blob_reopen', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 103086, 'EndLine': 103086, 'SourceCode': 'SQLITE_API int sqlite3_blob_reopen(sqlite3_blob *pBlob, sqlite3_int64 iRow){'}, {'Name': 'returnSingleInt', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 139659, 'EndLine': 139659, 'SourceCode': 'static void returnSingleInt(Vdbe *v, i64 value){'}, {'Name': 'fts5ConfigParseColumn', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 237764, 'EndLine': 237764, 'SourceCode': 'static int fts5ConfigParseColumn('}, {'Name': 'vtabCallConstructor', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 156828, 'EndLine': 156828, 'SourceCode': 'static int vtabCallConstructor('}, {'Name': 'exprCompareVariable', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 115550, 'EndLine': 115550, 'SourceCode': 'static int exprCompareVariable('}, {'Name': 'fts5ConfigSetEnum', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 237484, 'EndLine': 237484, 'SourceCode': 'static int fts5ConfigSetEnum('}, {'Name': 'sqlite3Fts5IndexQuery', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 249276, 'EndLine': 249276, 'SourceCode': 'static int sqlite3Fts5IndexQuery('}, {'Name': 'walIndexRecover', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 66364, 'EndLine': 66364, 'SourceCode': 'static int walIndexRecover(Wal *pWal){'}, {'Name': 'checkMutexEnd', 'FilePath': '/home/nate/code/m