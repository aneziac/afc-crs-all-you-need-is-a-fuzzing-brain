}\n  sqlite3_free(zSql);\n  if( sResult.azElem==0 ){\n    db_query_callback(&sResult, 0, 0, 0);\n  }\n  sResult.azElem[sResult.nElem] = 0;\n  return sResult.azElem;\n}'}, {'Name': 'subjournalPage', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 61703, 'EndLine': 61703, 'SourceCode': 'static int subjournalPage(PgHdr *pPg){'}, {'Name': 'propagateConstantExprRewrite', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 148551, 'EndLine': 148551, 'SourceCode': 'static int propagateConstantExprRewrite(Walker *pWalker, Expr *pExpr){'}, {'Name': 'robustFchown', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 39048, 'EndLine': 39048, 'SourceCode': 'static int robustFchown(int fd, uid_t uid, gid_t gid){'}, {'Name': 'winIsLongPathPrefix', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 52253, 'EndLine': 52253, 'SourceCode': 'static BOOL winIsLongPathPrefix('}, {'Name': 'getNextToken', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 194383, 'EndLine': 194383, 'SourceCode': 'static int getNextToken('}, {'Name': 'sessionUpdateMaxSize', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 227838, 'EndLine': 227838, 'SourceCode': 'static int sessionUpdateMaxSize('}, {'Name': 'sqlite3MemTraceDeactivate', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/dbfuzz2.c', 'StartLine': 150, 'EndLine': 160, 'SourceCode': 'int sqlite3MemTraceDeactivate(void){\n  int rc = SQLITE_OK;\n  if( memtraceBase.xMalloc!=0 ){\n    rc = sqlite3_config(SQLITE_CONFIG_MALLOC, &memtraceBase);\n    if( rc==SQLITE_OK ){\n      memset(&memtraceBase, 0, sizeof(memtraceBase));\n    }\n  }\n  memtraceOut = 0;\n  return rc;\n}'}, {'Name': 'fts5DecodeDoclist', 'FilePath': '/home/n