mcpy(ctx->u.in, buf, len);\n}'}, {'Name': 'sqlite3_mutex_leave', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 29273, 'EndLine': 29273, 'SourceCode': 'SQLITE_API void sqlite3_mutex_leave(sqlite3_mutex *p){'}, {'Name': 'fts5DebugRowid', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 250539, 'EndLine': 250539, 'SourceCode': 'static void fts5DebugRowid(int *pRc, Fts5Buffer *pBuf, i64 iKey){'}, {'Name': 'flockCheckReservedLock', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 40912, 'EndLine': 40912, 'SourceCode': 'static int flockCheckReservedLock(sqlite3_file *id, int *pResOut){'}, {'Name': 'sqlite3rebaser_rebase', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 232736, 'EndLine': 232736, 'SourceCode': 'SQLITE_API int sqlite3rebaser_rebase('}, {'Name': 'fts5IsTokendataPrefix', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 248827, 'EndLine': 248827, 'SourceCode': 'static int fts5IsTokendataPrefix('}, {'Name': 'sessionPreupdateOld', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 228200, 'EndLine': 228200, 'SourceCode': 'static int sessionPreupdateOld(void *pCtx, int iVal, sqlite3_value **ppVal){'}, {'Name': 'fts5SpecialDelete', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 253112, 'EndLine': 253112, 'SourceCode': 'static int fts5SpecialDelete('}, {'Name': 'main', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/threadtest2.c', 'StartLine': 98, 'EndLine': 133, 'SourceCode': 'int main(int argc, char **argv){\n  sqlite *db;\n  int i, rc;\n  pthread_t aThread[5];\n\n  if( strcmp(DB_FILE,":memory:") ){\n    char *zJournal = sqlite3_mprintf("%s-journal", DB_FILE);\n    unlink(DB_FILE);\n    unlink(zJournal);\n    sqlite3_free(zJournal);\n  }  \n  sqlite3_open(DB_FILE, &db);\n  if( db==0 ){\n    fprintf(stderr,"unable to initialize database\\n");\n    exit(1);\n  }\n  rc = sqlite3_exec(db, "CREATE TABLE t1(x);", 0,0,0);\n  if( rc ){\n    fprintf(stderr,"cannot create table t1: %d\\n", rc);\n    exit(1);\n  }\n  sqlite3_close(db);\n  for(i=0; i<sizeof(aThread)/sizeof(aThread[0]); i++){\n    pthread_create(&aThread[i], 0, worker, (void*)i);\n  }\n  for(i=0; i<sizeof(aThread)/sizeof(aThread[i]); i++){\n    pthread_join(aThread[i], 0);\n  }\n  if( !all_stop ){\n    printf("Everything seems ok.\\n");\n    return 0;\n  }else{\n    printf("We hit an error.\\n");\n    return 1;\n  }\n}'}, {'Name': 'fts3StrHash', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 195600, 'EndLine': 195600, 'SourceCode': 'static int fts3StrHash(const void *pKey, int nKey){'}, {'Name': 'sessionConflictHandler', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 231031, 'EndLine': 231031, 'SourceCode': 'static int sessionConflictHandler('}, {'Name': 'sqlite3changeset_apply_v2_strm', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 231653, 'EndLine': 231653, 'SourceCode': 'SQLITE_API int sqlite3changeset_apply_v2_strm('}, {'Name': 'intTestFunc', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 196973, 'EndLine': 196973, 'SourceCode': 'static void intTestFunc('}, {'Name': 'pcache1Unpin', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 56301, 'EndLine': 56301, 'SourceCode': 'static void pcache1Unpin('}, {'Name': 'fts5ApiTokenize', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 253509, 'EndLine': 253509, 'SourceCode': 'static int fts5ApiTokenize('}, {'Name': 'sq