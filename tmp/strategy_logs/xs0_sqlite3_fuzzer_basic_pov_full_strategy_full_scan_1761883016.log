l(p, "PRAGMA synchronous=OFF;");\n  run_sql(p, "ATTACH \'tt4-test%d.db\' AS aux1", aOrder[x][1]);\n  run_sql(p, "ATTACH \'tt4-test%d.db\' AS aux2", aOrder[x][2]);\n}'}, {'Name': 'fillInCell', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 77627, 'EndLine': 77627, 'SourceCode': 'static int fillInCell('}, {'Name': 'fts3EvalStartReaders', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 192340, 'EndLine': 192340, 'SourceCode': 'static void fts3EvalStartReaders('}, {'Name': 'fts5VocabFilterMethod', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 259918, 'EndLine': 259918, 'SourceCode': 'static int fts5VocabFilterMethod('}, {'Name': 'concatFuncCore', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 130819, 'EndLine': 130819, 'SourceCode': 'static void concatFuncCore('}, {'Name': 'walIndexAppend', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 66275, 'EndLine': 66275, 'SourceCode': 'static int walIndexAppend(Wal *pWal, u32 iFrame, u32 iPage){'}, {'Name': 'sqlite3Fts5IterNextFrom', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 249410, 'EndLine': 249410, 'SourceCode': 'static int sqlite3Fts5IterNextFrom(Fts5IndexIter *pIndexIter, i64 iMatch){'}, {'Name': 'HashFinal', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/speedtest1.c', 'StartLine': 182, 'EndLine': 196, 'SourceCode': 'static void HashFinal(void){\n  unsigned int k;\n  unsigned char t, i, j;\n  i = g.hash.i;\n  j = g.hash.j;\n  for(k=0; k<32; k++){\n    i++;\n    t = g.hash.s[i];\n    j += t;\n    g.hash.s[i] = g.hash.s[j];\n    g.hash.s[j] = t;\n    t += g.hash.s[i];\n    g.hash.r[k] = g.hash.s[t];\n  }\n}'}, {'Name': 'fts5IndexTombstoneAdd', 'FilePath': '/home/nate/co