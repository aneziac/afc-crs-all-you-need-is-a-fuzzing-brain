: 198, 'EndLine': 239, 'SourceCode': 'static int integerValue(const char *zArg){\n  int v = 0;\n  static const struct { char *zSuffix; int iMult; } aMult[] = {\n    { "KiB", 1024 },\n    { "MiB", 1024*1024 },\n    { "GiB", 1024*1024*1024 },\n    { "KB",  1000 },\n    { "MB",  1000000 },\n    { "GB",  1000000000 },\n    { "K",   1000 },\n    { "M",   1000000 },\n    { "G",   1000000000 },\n  };\n  int i;\n  int isNeg = 0;\n  if( zArg[0]==\'-\' ){\n    isNeg = 1;\n    zArg++;\n  }else if( zArg[0]==\'+\' ){\n    zArg++;\n  }\n  if( zArg[0]==\'0\' && zArg[1]==\'x\' ){\n    int x;\n    zArg += 2;\n    while( (x = hexDigitValue(zArg[0]))>=0 ){\n      v = (v<<4) + x;\n      zArg++;\n    }\n  }else{\n    while( zArg[0]>=\'0\' && zArg[0]<=\'9\' ){\n      v = v*10 + zArg[0] - \'0\';\n      zArg++;\n    }\n  }\n  for(i=0; i<sizeof(aMult)/sizeof(aMult[0]); i++){\n    if( sqlite3_stricmp(aMult[i].zSuffix, zArg)==0 ){\n      v *= aMult[i].iMult;\n      break;\n    }\n  }\n  return isNeg? -v : v;\n}'}, {'Name': 'showAllWhereLoops', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 169275, 'EndLine': 169275, 'SourceCode': 'static void showAllWhereLoops(WhereInfo *pWInfo, WhereClause *pWC){'}, {'Name': 'fts3DoIncrmerge', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 202890, 'EndLine': 202890, 'SourceCode': 'static int fts3DoIncrmerge('}, {'Name': 'moveToRightmost', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 76244, 'EndLine': 76244, 'SourceCode': 'static int moveToRightmost(BtCursor *pCur){'}, {'Name': 'sqlite3_stmt_scanstatus', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 93066, 'EndLine': 93066, 'SourceCode': 'SQLITE_API int sqlite3_stmt_scanstatus('}, {'Name': 'fts3Rehash', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'Sta