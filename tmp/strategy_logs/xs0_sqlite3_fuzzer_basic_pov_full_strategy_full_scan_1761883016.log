 'static Statement *getSqlStatement(\n  Error *pErr,                    /* IN/OUT: Error code */\n  Sqlite *pDb,                    /* Database handle */\n  const char *zSql                /* SQL statement */\n){\n  Statement *pRet;\n  int rc;\n\n  for(pRet=pDb->pCache; pRet; pRet=pRet->pNext){\n    if( 0==strcmp(sqlite3_sql(pRet->pStmt), zSql) ){\n      return pRet;\n    }\n  }\n\n  pRet = sqlite3_malloc(sizeof(Statement));\n  rc = sqlite3_prepare_v2(pDb->db, zSql, -1, &pRet->pStmt, 0);\n  if( rc!=SQLITE_OK ){\n    sqlite_error(pErr, pDb, "prepare_v2");\n    return 0;\n  }\n  assert( 0==strcmp(sqlite3_sql(pRet->pStmt), zSql) );\n\n  pRet->pNext = pDb->pCache;\n  pDb->pCache = pRet;\n  return pRet;\n}'}, {'Name': 'rtreeSavepoint', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 214909, 'EndLine': 214909, 'SourceCode': 'static int rtreeSavepoint(sqlite3_vtab *pVtab, int iSavepoint){'}, {'Name': 'kvvfsSyncDb', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 38175, 'EndLine': 38175, 'SourceCode': 'static int kvvfsSyncDb(sqlite3_file *pProtoFile, int flags){'}, {'Name': 'fts5IndexFreeArray', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 245113, 'EndLine': 245113, 'SourceCode': 'static void fts5IndexFreeArray(Fts5Data **ap, int n){'}, {'Name': 'cellArea', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 213733, 'EndLine': 213733, 'SourceCode': 'static RtreeDValue cellArea(Rtree *pRtree, RtreeCell *p){'}, {'Name': 'memjrnlFreeChunks', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 106472, 'EndLine': 106472, 'SourceCode': 'static void memjrnlFreeChunks(FileChunk *pFirst){'}, {'Name': 'rbuVfsLock', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 224267, 'EndLi