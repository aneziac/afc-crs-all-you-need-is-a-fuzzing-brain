nst int iDivisor[] = { 1, 1000, 100, 10, 1 };\n    v = (v/iDivisor[N])%10;\n    sqlite3_result_int(context, v);\n  }\n  return SQLITE_OK;\n}'}, {'Name': 'whereInfoFree', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 165717, 'EndLine': 165717, 'SourceCode': 'static void whereInfoFree(sqlite3 *db, WhereInfo *pWInfo){'}, {'Name': 'fts5StructureMakeWritable', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 243271, 'EndLine': 243271, 'SourceCode': 'static void fts5StructureMakeWritable(int *pRc, Fts5Structure **pp){'}, {'Name': 'sqlite3Fts5IndexWrite', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 248789, 'EndLine': 248789, 'SourceCode': 'static int sqlite3Fts5IndexWrite('}, {'Name': 'sessionGenerateChangeset', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 229240, 'EndLine': 229240, 'SourceCode': 'static int sessionGenerateChangeset('}, {'Name': 'xorMemory', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 52587, 'EndLine': 52587, 'SourceCode': 'static void xorMemory(EntropyGatherer *p, unsigned char *x, int sz){'}, {'Name': 'main', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/ossshell.c', 'StartLine': 38, 'EndLine': 100, 'SourceCode': 'int main(int argc, char **argv){\n  FILE *in;\n  int i;\n  int nErr = 0;\n  uint8_t *zBuf = 0;\n  size_t sz;\n  unsigned mDebug = 0;\n\n  for(i=1; i<argc; i++){\n    const char *zFilename = argv[i];\n    if( zFilename[0]==\'-\' ){\n      if( zFilename[1]==\'-\' ) zFilename++;\n      if( strcmp(zFilename, "-show-errors")==0 ){\n        mDebug |= FUZZ_SHOW_ERRORS;\n        ossfuzz_set_debug_flags(mDebug);\n      }else\n      if( strcmp(zFilename, "-show-max-delay")==0 ){\n        mDebug |= FUZZ_SHOW_MAX_DELAY;\n        ossfuzz_set_debug_flags(mDebug);\n      }else\n      if( strcmp(zFilename, "-sql-trace")==0 ){\n        mDebug |= FUZZ_SQL_TRACE;\n        ossfuzz_set_debug_flags(mDebug);\n      }else\n      {\n        printf("unknown option \\"%s\\"\\n", argv[i]);\n        printf("should be one of: --show-errors --show-max-delay"\n               " --sql-trace\\n");\n        exit(1);\n      }\n      continue;\n    }\n    in = fopen(zFilename, "rb");\n    if( in==0 ){\n      fprintf(stderr, "cannot open \\"%s\\"\\n", zFilename);\n      nErr++;\n      continue;\n    }\n    fseek(in, 0, SEEK_END);\n    sz = ftell(in);\n    rewind(in);\n    zBuf = realloc(zBuf, sz);\n    if( zBuf==0 ){\n      fprintf(stderr, "cannot malloc() for %d bytes\\n", (int)sz);\n      exit(1);\n    }\n    if( fread(zBuf, sz, 1, in)!=1 ){\n      fprintf(stderr, "cannot read %d bytes from \\"%s\\"\\n",\n                       (int)sz, zFilename);\n      nErr++;\n    }else{\n      printf("%s... ", zFilename);\n      if( mDebug ) printf("\\n");\n      fflush(stdout);\n      (void)LLVMFuzzerTestOneInput(zBuf, sz);\n      if( mDebug ) printf("%s: ", zFilename);\n      printf("ok\\n");\n    }\n    fclose(in);\n  }\n  free(zBuf);\n  return nErr;\n}'}, {'Name': 'unixTruncate', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 42242, 'EndLine': 42242, 'SourceCode': 'static int unixTruncate(sqlite3_file *id, i64 nByte){'}, {'Name': 'sqlite3_data_count', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 91763, 'EndLine': 91763, 'SourceCode': 'SQLITE_API int sqlite3_data_count(sqlite3_stmt *pStmt){'}, {'Name': 'sqlite3changeset_old', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 230157, 'EndLine': 230157, 'SourceCode': 'SQLITE_API int sqlite3changeset_old('}, {'Name': 'walUnlockShared', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 6607