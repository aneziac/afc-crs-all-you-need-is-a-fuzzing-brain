      "INSERT INTO t1 VALUES(:iNextWrite, :iSum1, :iSum2)",\n        &iNextWrite, &sum1, &sum2\n    );\n    integrity_check(&err, &db);\n\n    iNextWrite += WALTHREAD3_NTHREAD;\n  }\n\n  closedb(&err, &db);\n  print_and_free_err(&err);\n  return 0;\n}'}, {'Name': 'rbuVfsFullPathname', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 224679, 'EndLine': 224679, 'SourceCode': 'static int rbuVfsFullPathname('}, {'Name': 'parseYyyyMmDd', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 24739, 'EndLine': 24739, 'SourceCode': 'static int parseYyyyMmDd(const char *zDate, DateTime *p){'}, {'Name': 'fts5IndexTombstoneRebuild', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 249776, 'EndLine': 249776, 'SourceCode': 'static void fts5IndexTombstoneRebuild('}, {'Name': 'sqlite3Fts5ParsePhraseFree', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 240177, 'EndLine': 240177, 'SourceCode': 'static void sqlite3Fts5ParsePhraseFree(Fts5ExprPhrase *pPhrase){'}, {'Name': 'rbuVfsDelete', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 224622, 'EndLine': 224622, 'SourceCode': 'static int rbuVfsDelete(sqlite3_vfs *pVfs, const char *zPath, int dirSync){'}, {'Name': 'exprMightBeIndexed', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 162281, 'EndLine': 162281, 'SourceCode': 'static int exprMightBeIndexed('}, {'Name': 'jsonBlobEdit', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 208669, 'EndLine': 208669, 'SourceCode': 'static void jsonBlobEdit('}, {'Name': 'renameTestSchema', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 116748, 'EndLine': 116748, 'SourceCode': 'static void 