lite3_exec(db, "PRAGMA synchronous=OFF", 0, 0, 0);\n    /* integrity_check(db, id); */\n    if( all_stop ){ sqlite3_close(db); break; }\n    /* fprintf(stderr, "%d: BEGIN\\n", id); */\n    rc = sqlite3_exec(db, "INSERT INTO t1 VALUES(\'bogus data\')", 0, 0, 0);\n    /* fprintf(stderr, "%d: END rc=%d\\n", id, rc); */\n    sqlite3_close(db);\n  }\n  fprintf(stderr, "Worker %d finished\\n", id);\n  return 0;\n}'}, {'Name': 'sqlite3RunSql', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/vt02.c', 'StartLine': 480, 'EndLine': 507, 'SourceCode': 'static void sqlite3RunSql(\n  sqlite3 *db,               /* Run the SQL on this database connection */\n  sqlite3_vtab *pVTab,       /* Report errors to this virtual table */\n  const char *zFormat,       /* Format string for SQL, or NULL */\n  ...                        /* Arguments, according to the format string */\n){\n  char *zSql;\n\n  va_list ap;\n  va_start(ap, zFormat);\n  if( zFormat==0 ){\n    zSql = va_arg(ap, char*);\n  }else{\n    zSql = sqlite3_vmprintf(zFormat, ap);\n  }\n  va_end(ap);\n  if( zSql ){\n    char *zErrMsg = 0;\n    (void)sqlite3_exec(db, zSql, 0, 0, &zErrMsg);\n    if( zErrMsg ){\n      if( pVTab->zErrMsg==0 ){\n        pVTab->zErrMsg = sqlite3_mprintf("%s in [%s]", zErrMsg, zSql);\n      }\n      sqlite3_free(zErrMsg);\n    }\n    sqlite3_free(zSql);\n  }\n}'}, {'Name': 'fts5IterSetOutputsTokendata', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 248969, 'EndLine': 248969, 'SourceCode': 'static void fts5IterSetOutputsTokendata(Fts5Iter *pIter){'}, {'Name': 'fts3isspace', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 194323, 'EndLine': 194323, 'SourceCode': 'static int fts3isspace(char c){'}, {'Name': 'fts5CursorParseRank', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 252533, 'EndLine': 252533, 'SourceCode