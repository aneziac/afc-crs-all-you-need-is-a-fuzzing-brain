l_script(&err, &db,\n        "BEGIN;"\n          "INSERT INTO t1 VALUES(randomblob(100));"\n          "INSERT INTO t1 VALUES(randomblob(100));"\n          "INSERT INTO t1 SELECT md5sum(x) FROM t1;"\n        "COMMIT;"\n    );\n    nIter++;\n  }\n  closedb(&err, &db);\n\n  print_and_free_err(&err);\n  return sqlite3_mprintf("%d iterations", nIter);\n}'}, {'Name': 'prepare', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/threadtest5.c', 'StartLine': 91, 'EndLine': 117, 'SourceCode': 'static sqlite3_stmt *prepare(\n  sqlite3 *db,\n  const char *zId,\n  int lineno,\n  const char *zFormat,\n  ...\n){\n  int rc;\n  va_list ap;\n  char *zSql;\n  sqlite3_stmt *pStmt = 0;\n  va_start(ap, zFormat);\n  zSql = sqlite3_vmprintf(zFormat, ap);\n  va_end(ap);\n  if( eVerbose){\n    printf("%s:%d: [%s]\\n", zId, lineno, zSql);\n    fflush(stdout);\n  }\n\n  rc = sqlite3_prepare_v2(db, zSql, -1, &pStmt, 0);\n  if( rc ){\n    printf("%s:%d: ERROR - %s\\n", zId, lineno, sqlite3_errmsg(db));\n    exit(-1);\n  }\n  sqlite3_free(zSql);\n  return pStmt;\n}'}, {'Name': 'fts5SnippetScore', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 236404, 'EndLine': 236404, 'SourceCode': 'static int fts5SnippetScore('}, {'Name': 'fts5IndexDiscardData', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 246371, 'EndLine': 246371, 'SourceCode': 'static void fts5IndexDiscardData(Fts5Index *p){'}, {'Name': 'winGetLastErrorMsg', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 48709, 'EndLine': 48709, 'SourceCode': 'static int winGetLastErrorMsg(DWORD lastErrno, int nBuf, char *zBuf){'}, {'Name': 'jsonEachBestIndex', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 211312, 'EndLine': 211312, 'SourceCode': 'static int jsonEachBestIndex('}, {'Name': 'sqlite3Fts5StorageClose