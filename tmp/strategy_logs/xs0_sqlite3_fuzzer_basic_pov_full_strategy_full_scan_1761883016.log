n    pNew->pNext = 0;\n    memcpy(pNew->a, sqlite3_column_blob(pStmt,1), sz);\n    pNew->a[sz] = 0;\n    p->pNext = pNew;\n    p = pNew;\n  }\n  sqlite3_finalize(pStmt);\n  *pN = n;\n  *ppList = head.pNext;\n}'}, {'Name': 'winMapfile', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 51130, 'EndLine': 51130, 'SourceCode': 'static int winMapfile(winFile *pFd, sqlite3_int64 nByte){'}, {'Name': 'rtreeCheckAppendMsg', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 215499, 'EndLine': 215499, 'SourceCode': 'static void rtreeCheckAppendMsg(RtreeCheck *pCheck, const char *zFmt, ...){'}, {'Name': 'sessionAppendValue', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 228706, 'EndLine': 228706, 'SourceCode': 'static void sessionAppendValue(SessionBuffer *p, sqlite3_value *pVal, int *pRc){'}, {'Name': 'displayLinuxIoStats', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/kvtest.c', 'StartLine': 681, 'EndLine': 710, 'SourceCode': 'static void displayLinuxIoStats(FILE *out){\n  FILE *in;\n  char z[200];\n  sqlite3_snprintf(sizeof(z), z, "/proc/%d/io", getpid());\n  in = fopen(z, "rb");\n  if( in==0 ) return;\n  while( fgets(z, sizeof(z), in)!=0 ){\n    static const struct {\n      const char *zPattern;\n      const char *zDesc;\n    } aTrans[] = {\n      { "rchar: ",                  "Bytes received by read():" },\n      { "wchar: ",                  "Bytes sent to write():"    },\n      { "syscr: ",                  "Read() system calls:"      },\n      { "syscw: ",                  "Write() system calls:"     },\n      { "read_bytes: ",             "Bytes read from storage:"  },\n      { "write_bytes: ",            "Bytes written to storage:" },\n      { "cancelled_write_bytes: ",  "Cancelled write bytes:"    },\n    };\n    int i;\n    for(i=0; i<sizeof(aTrans)/sizeof(aTrans[0]); i++){\n      int n = (int)strlen(aTrans[i].zPattern);\n      if( strncmp(aTrans[i].zPattern, z, n)==0 ){\n        fprintf(out, "%-36s %s", aTrans[i].zDesc, &z[n]);\n        break;\n      }\n    }\n  }\n  fclose(in);\n}'}, {'Name': 'sqlite3_enable_load_extension', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 138589, 'EndLine': 138589, 'SourceCode': 'SQLITE_API int sqlite3_enable_load_extension(sqlite3 *db, int onoff){'}, {'Name': 'sqlite3session_enable', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 229425, 'EndLine': 229425, 'SourceCode': 'SQLITE_API int sqlite3session_enable(sqlite3_session *pSession, int bEnable){'}, {'Name': 'fts5ExprNodeZeroPoslist', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 239424, 'EndLine': 239424, 'SourceCode': 'static void fts5ExprNodeZeroPoslist(Fts5ExprNode *pNode){'}, {'Name': 'checkTreePage', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 81398, 'EndLine': 81398, 'SourceCode': 'static int checkTreePage('}, {'Name': 'vfsUnlink', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 26615, 'EndLine': 26615, 'SourceCode': 'static void vfsUnlink(sqlite3_vfs *pVfs){'}, {'Name': 'proxyUnlock', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 46496, 'EndLine': 46496, 'SourceCode': 'static int proxyUnlock(sqlite3_file *id, int eFileLock) {'}, {'Name': 'walMergesort', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 66848, 'EndLine': 66848, 'SourceCode': 'static void walMergesort('}, {'Name': 'fts5Fts5Func', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 254896, 'EndLine': 254896, 'SourceCode': 'static void fts5Fts5Func('}, {'Name': 