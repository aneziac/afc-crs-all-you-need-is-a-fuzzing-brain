eCode': 'static void runSql(sqlite3 *db, const char *zSql, unsigned  runFlags){\n  const char *zMore;\n  const char *zEnd = &zSql[strlen(zSql)];\n  sqlite3_stmt *pStmt;\n\n  while( zSql && zSql[0] ){\n    zMore = 0;\n    pStmt = 0;\n    sqlite3_prepare_v2(db, zSql, -1, &pStmt, &zMore);\n    assert( zMore<=zEnd );\n    if( zMore==zSql ) break;\n    if( runFlags & SQL_TRACE ){\n      const char *z = zSql;\n      int n;\n      while( z<zMore && ISSPACE(z[0]) ) z++;\n      n = (int)(zMore - z);\n      while( n>0 && ISSPACE(z[n-1]) ) n--;\n      if( n==0 ) break;\n      if( pStmt==0 ){\n        printf("TRACE: %.*s (error: %s)\\n", n, z, sqlite3_errmsg(db));\n      }else{\n        printf("TRACE: %.*s\\n", n, z);\n      }\n    }\n    zSql = zMore;\n    if( pStmt ){\n      if( (runFlags & SQL_OUTPUT)==0 ){\n        while( SQLITE_ROW==sqlite3_step(pStmt) ){}\n      }else{\n        int nCol = -1;\n        int nRow;\n        for(nRow=0; SQLITE_ROW==sqlite3_step(pStmt); nRow++){\n          int i;\n          if( nCol<0 ){\n            nCol = sqlite3_column_count(pStmt);\n          }\n          for(i=0; i<nCol; i++){\n            int eType = sqlite3_column_type(pStmt,i);\n            printf("ROW[%d].%s = ", nRow, sqlite3_column_name(pStmt,i));\n            switch( eType ){\n              case SQLITE_NULL: {\n                printf("NULL\\n");\n                break;\n              }\n              case SQLITE_INTEGER: {\n                printf("INT %s\\n", sqlite3_column_text(pStmt,i));\n                break;\n              }\n              case SQLITE_FLOAT: {\n                printf("FLOAT %s\\n", sqlite3_column_text(pStmt,i));\n                break;\n              }\n              case SQLITE_TEXT: {\n                printf("TEXT [%s]\\n", sqlite3_column_text(pStmt,i));\n                break;\n              }\n              case SQLITE_BLOB: {\n                printf("BLOB (%d bytes)\\n", sqlite3_column_bytes(pStmt,i));\n                break;\n              }\n            }\n          }\n        }\n      }         \n      sqlite3_finalize(pStmt);\n    }\n  }\n}'}, {'Name': 'fts5SegIterNextInit', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 244987, 'EndLine': 244987, 'SourceCode': 'static void fts5SegIterNextInit('}, {'Name': 'sqlite3_value_numeric_type', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 93811, 'EndLine': 93811, 'SourceCode': 'SQLITE_API int sqlite3_value_numeric_type(sqlite3_value *pVal){'}, {'Name': 'setDoNotMergeFlagOnCopy', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 113796, 'EndLine': 113796, 'SourceCode': 'static void setDoNotMergeFlagOnCopy(Vdbe *v){'}, {'Name': 'fts5StorageInsertDocsize', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 255817, 'EndLine': 255817, 'SourceCode': 'static int fts5StorageInsertDocsize('}, {'Name': 'stmtOpen', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 260245, 'EndLine': 260245, 'SourceCode': 'static int stmtOpen(sqlite3_vtab *p, sqlite3_vtab_cursor **ppCursor){'}, {'Name': 'sqlite3_stricmp', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 35539, 'EndLine': 35539, 'SourceCode': 'SQLITE_API int sqlite3_stricmp(const char *zLeft, const char *zRight){'}, {'Name': 'exprNodeIsConstantOrGroupBy', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 112070, 'EndLine': 112070, 'SourceCode': 'static int exprNodeIsConstantOrGroupBy(Walker *pWalker, Expr *pExpr){'}, {'Name': 'sqlite3Fts5StorageOpen', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 255509, 'EndLine': 255509, 'SourceCode': 'static int sqlite3Fts5StorageOpen('}, {'Name': 'fts3SnippetFunc', 'FilePath': '/home/n