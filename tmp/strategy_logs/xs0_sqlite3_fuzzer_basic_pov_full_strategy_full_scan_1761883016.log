ogress(sqlite3rbu *pRbu){'}, {'Name': 'sqlite3_preupdate_depth', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 92799, 'EndLine': 92799, 'SourceCode': 'SQLITE_API int sqlite3_preupdate_depth(sqlite3 *db){'}, {'Name': 'testset_parsenumber', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/speedtest1.c', 'StartLine': 2158, 'EndLine': 2194, 'SourceCode': 'void testset_parsenumber(void){\n  const char *zSql1 = "SELECT 1, 12, 123, 1234, 12345, 123456";\n  const char *zSql2 = "SELECT 8227256643844975616, 7932208612563860480, "\n                      "2010730661871032832, 9138463067404021760, "\n                      "2557616153664746496, 2557616153664746496";\n  const char *zSql3 = "SELECT 1.0, 1.2, 1.23, 123.4, 1.2345, 1.23456";\n  const char *zSql4 = "SELECT 8.227256643844975616, 7.932208612563860480, "\n                      "2.010730661871032832, 9.138463067404021760, "\n                      "2.557616153664746496, 2.557616153664746496";\n\n  const int NROW = 100*g.szTest;\n  int ii;\n\n  speedtest1_begin_test(100, "parsing small integers");\n  for(ii=0; ii<NROW; ii++){\n    sqlite3_exec(g.db, zSql1, 0, 0, 0);\n  }\n  speedtest1_end_test();\n\n  speedtest1_begin_test(110, "parsing large integers");\n  for(ii=0; ii<NROW; ii++){\n    sqlite3_exec(g.db, zSql2, 0, 0, 0);\n  }\n  speedtest1_end_test();\n\n  speedtest1_begin_test(200, "parsing small reals");\n  for(ii=0; ii<NROW; ii++){\n    sqlite3_exec(g.db, zSql3, 0, 0, 0);\n  }\n  speedtest1_end_test();\n\n  speedtest1_begin_test(210, "parsing large reals");\n  for(ii=0; ii<NROW; ii++){\n    sqlite3_exec(g.db, zSql4, 0, 0, 0);\n  }\n  speedtest1_end_test();\n}'}, {'Name': 'integerValue', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/test/startup.c', 'StartLine': 430, 'EndLine': 475, 'SourceCode': 'static int integerValue(const char *zArg){\n  sqlite3_int64 v = 0;\n  static const struct { char *zSuffix; int iMult; } aMult[] = {\n    { "KiB", 1024 },\n    { "MiB", 1024*1024 },\n    { "GiB", 1024*1024*1024 },\n    { "KB",  1000 },\n    { "MB",  1000000 },\n    { "GB",  1000000000 },\n    { "K",   1000 },\n    { "M",   1000000 },\n    { "G",   1000000000 },\n  };\n  int i;\n  int isNeg = 0;\n  if( zArg[0]==\'-\' ){\n    isNeg = 1;\n    zArg++;\n  }else if( zArg[0]==\'+\' ){\n    zArg++;\n  }\n  if( zArg[0]==\'0\' && zArg[1]==\'x\' ){\n    int x;\n    zArg += 2;\n    while( (x = hexDigitValue(zArg[0]))>=0 ){\n      v = (v<<4) + x;\n      zArg++;\n    }\n  }else{\n    while( isdigit(zArg[0]) ){\n      v = v*10 + zArg[0] - \'0\';\n      zArg++;\n    }\n  }\n  for(i=0; i<sizeof(aMult)/sizeof(aMult[0]); i++){\n    if( sqlite3_stricmp(aMult[i].zSuffix, zArg)==0 ){\n      v *= aMult[i].iMult;\n      break;\n    }\n  }\n  if( v>0x7fffffff ){\n    printf("ERROR: parameter too large - max 2147483648\\n");\n    exit(1);\n  }\n  return (int)(isNeg? -v : v);\n}'}, {'Name': 'setPageReferenced', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 81200, 'EndLine': 81200, 'SourceCode': 'static void setPageReferenced(IntegrityCk *pCheck, Pgno iPg){'}, {'Name': 'changeTempStorage', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 139625, 'EndLine': 139625, 'SourceCode': 'static int changeTempStorage(Parse *pParse, const char *zStorageType){'}, {'Name': 'releaseInodeInfo', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 39821, 'EndLine': 39821, 'SourceCode': 'static void releaseInodeInfo(unixFile *pFile){'}, {'Name': 'growOpArray', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 85117, 'EndLine': 85117, 'SourceCode': 'static int growOpArray(Vdbe *v, int nOp){'}, {'Name': 'loadExt', 'FilePath': '/home/nate/code/minimal/local-test-sqlite3-full-01/afc-sqlite3/sqlite3.c', 'StartLine': 13097